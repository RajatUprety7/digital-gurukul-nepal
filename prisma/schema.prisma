generator client { provider = "prisma-client-js" }

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  student
  parent
  instructor
  admin
  school_partner
}
enum Domain {
  visual_coding
  python
  web_development
  javascript
  ai_basics
  cyber_safety
  mobile_app
}
enum ChallengeType {
  python
  html_css_js
  javascript
  project
  quiz
}
enum SubmissionStatus {
  submitted
  checked
  needs_correction
}
enum PaymentStatus {
  pending
  paid
  failed
  refunded
}
enum CertificateStatus {
  pending
  issued
  revoked
}

model User {
  id             String @id @default(cuid())
  name           String
  email          String @unique
  phone          String?
  password       String
  role           Role @default(student)
  studentClass   String?
  schoolName     String?
  parentName     String?
  isActive       Boolean @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  instructorCourses Course[] @relation("InstructorCourses")
  enrollments    Enrollment[]
  codeSubmissions CodeSubmission[]
  projectSubmissions ProjectSubmission[]
  assignmentSubmissions AssignmentSubmission[]
  quizAttempts   QuizAttempt[]
  payments       Payment[]
  progress       Progress[]
  certificates   Certificate[]
  aiPracticeSubmissions AIPracticeSubmission[]
}

model Course {
  id          String @id @default(cuid())
  title       String
  domain      Domain
  classRange  String?
  description String?
  price       Int @default(2000)
  isPublished Boolean @default(true)
  instructorId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  instructor  User? @relation("InstructorCourses", fields: [instructorId], references: [id])
  modules     Module[]
  enrollments Enrollment[]
  challenges  CodeChallenge[]
  assignments Assignment[]
  quizzes     Quiz[]
  progress    Progress[]
  certificates Certificate[]
}

model Module {
  id          String @id @default(cuid())
  title       String
  description String?
  order       Int @default(0)
  courseId    String
  course      Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]
}

model Lesson {
  id        String @id @default(cuid())
  title     String
  content   String?
  videoUrl  String?
  notesUrl  String?
  order     Int @default(0)
  moduleId  String
  module    Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
}

model Enrollment {
  id        String @id @default(cuid())
  studentId String
  courseId  String
  status    String @default("active")
  createdAt DateTime @default(now())
  student   User @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  @@unique([studentId, courseId])
}

model Admission {
  id              String @id @default(cuid())
  studentName     String
  studentClass    String
  schoolName      String?
  parentName      String?
  parentPhone     String
  email           String?
  preferredCourse String?
  message         String?
  status          String @default("new")
  createdAt       DateTime @default(now())
}

model CodeChallenge {
  id             String @id @default(cuid())
  title          String
  type           ChallengeType
  domain         Domain
  classRange     String?
  difficulty     String @default("Beginner")
  instructions   String
  starterCode    String?
  expectedOutput String?
  testHint       String?
  courseId       String?
  course         Course? @relation(fields: [courseId], references: [id])
  submissions    CodeSubmission[]
  createdAt      DateTime @default(now())
}

model CodeSubmission {
  id          String @id @default(cuid())
  studentId   String
  challengeId String
  code        String
  language    String
  output      String?
  status      String @default("submitted")
  score       Int @default(0)
  feedback    String?
  createdAt   DateTime @default(now())
  student     User @relation(fields: [studentId], references: [id], onDelete: Cascade)
  challenge   CodeChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
}

model ProjectSubmission {
  id          String @id @default(cuid())
  studentId   String
  title       String
  domain      Domain
  description String?
  projectUrl  String?
  fileUrl     String?
  feedback    String?
  status      String @default("submitted")
  createdAt   DateTime @default(now())
  student     User @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Assignment {
  id           String @id @default(cuid())
  title        String
  classRange   String?
  instructions String?
  dueDate      DateTime?
  maxMarks     Int @default(100)
  courseId     String?
  course       Course? @relation(fields: [courseId], references: [id])
  submissions  AssignmentSubmission[]
  createdAt    DateTime @default(now())
}

model AssignmentSubmission {
  id           String @id @default(cuid())
  assignmentId String
  studentId    String
  answerText   String?
  fileUrl      String?
  marks        Int?
  feedback     String?
  status       SubmissionStatus @default(submitted)
  createdAt    DateTime @default(now())
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      User @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Quiz {
  id          String @id @default(cuid())
  title       String
  description String?
  courseId    String?
  course      Course? @relation(fields: [courseId], references: [id])
  questions   Question[]
  attempts    QuizAttempt[]
  createdAt   DateTime @default(now())
}

model Question {
  id        String @id @default(cuid())
  quizId    String
  question  String
  options   String[] @default([])
  answer    String
  marks     Int @default(1)
  quiz      Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model QuizAttempt {
  id         String @id @default(cuid())
  quizId     String
  studentId  String
  score      Int @default(0)
  totalMarks Int @default(0)
  answers    Json?
  createdAt  DateTime @default(now())
  quiz       Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student    User @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Payment {
  id            String @id @default(cuid())
  studentId     String?
  studentName   String?
  parentPhone   String?
  amount        Int @default(2000)
  method        String @default("manual")
  transactionId String?
  status        PaymentStatus @default(pending)
  paidAt        DateTime?
  createdAt     DateTime @default(now())
  student       User? @relation(fields: [studentId], references: [id])
}

model Progress {
  id                String @id @default(cuid())
  studentId         String
  courseId          String
  completedLessons  String[] @default([])
  attendancePercent Int @default(0)
  assignmentPercent Int @default(0)
  projectStatus     String @default("Not Started")
  teacherRemarks    String?
  createdAt         DateTime @default(now())
  student           User @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course            Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  @@unique([studentId, courseId])
}

model Certificate {
  id            String @id @default(cuid())
  studentId     String
  courseId      String?
  certificateId String @unique
  title         String?
  issuedAt      DateTime?
  status        CertificateStatus @default(pending)
  createdAt     DateTime @default(now())
  student       User @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course        Course? @relation(fields: [courseId], references: [id])
}


model AIPracticeSubmission {
  id             String @id @default(cuid())
  studentId      String
  taskType       String
  title          String?
  prompt         String
  aiResponse     String?
  studentReflection String?
  score          Int @default(0)
  feedback       String?
  createdAt      DateTime @default(now())
  student        User @relation(fields: [studentId], references: [id], onDelete: Cascade)
}
